# Backend Environment Configuration (for local development)

# PostgreSQL Connection String (Points to local DB, e.g. docker-compose db container on host port 5434)
DATABASE_URL=Host=localhost;Port=5434;Database=school_admission_db;Username=postgres;Password=postgres;Include Error Detail=true;
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=school_admission_db;Username=postgres;Password=postgres;Include Error Detail=true;

# Seat Hold Duration in Seconds (Default: 600s / 10 minutes)
HOLD_DURATION_SECONDS=600

# Server Listening URL and Environment
ASPNETCORE_URLS=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development
